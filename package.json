{
  "name": "bitgard-web",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@bitgard/web",
    "dev:cms": "turbo run dev --filter=@bitgard/cms",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "npm run db:generate --workspace=@bitgard/database",
    "db:push": "npm run db:push --workspace=@bitgard/database",
    "db:studio": "npm run db:studio --workspace=@bitgard/database"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}