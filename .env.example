# Bitgard Website Environment Variables

# Supabase Database
DATABASE_URL="postgresql://user:password@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase API (you'll need to add these from your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URLs
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_URL="http://localhost:3001"

# Auth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET="generate-a-secure-secret-here"

# Cross-Service Signed Sync Bridge to Vigil (TB-8)
VIGIL_SYNC_URL="https://vigil-pos.vercel.app/api/bitgard/subscription-sync"
BITGARD_SYNC_SECRET="replace-with-shared-hmac-secret"

# Optional Distributed Rate Limiting (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Optional CMS Super-Admin Bootstrap Seed
# CMS_ADMIN_EMAIL="owner@bitgard.com"
# CMS_ADMIN_PASSWORD="strong-password-here"
# CMS_ADMIN_NAME="Bitgard Super Admin"
