# Bitgard Web Environment Variables Example
DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_URL="http://localhost:3001"
AUTH_SECRET="generate-a-secure-secret-here"

# Dodo Payments (Merchant of Record)
DODO_PAYMENTS_API_KEY="test_your_dodo_api_key_here"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" or "live_mode"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_your_webhook_secret_here"
# DODO_PAYMENTS_BUSINESS_ID="bus_..."

# Vigil Dodo Payments Product IDs (from Dodo Payments Dashboard)
VIGIL_PRODUCT_ID_STARTER="pdt_vigil_starter"
VIGIL_PRODUCT_ID_PROFESSIONAL="pdt_vigil_professional"
VIGIL_PRODUCT_ID_ENTERPRISE="pdt_vigil_enterprise"
# Optional billing-cycle specific Vigil product IDs:
# VIGIL_PRODUCT_ID_STARTER_MONTHLY="pdt_..."
# VIGIL_PRODUCT_ID_STARTER_ANNUAL="pdt_..."
# VIGIL_PRODUCT_ID_PROFESSIONAL_MONTHLY="pdt_..."
# VIGIL_PRODUCT_ID_PROFESSIONAL_ANNUAL="pdt_..."
# VIGIL_PRODUCT_ID_ENTERPRISE_MONTHLY="pdt_..."
# VIGIL_PRODUCT_ID_ENTERPRISE_ANNUAL="pdt_..."

# Cross-Service Signed Sync Bridge to Vigil (TB-8)
VIGIL_SYNC_URL="https://vigil-pos.vercel.app/api/bitgard/subscription-sync"
BITGARD_SYNC_SECRET="replace-with-shared-hmac-secret"

# Cron & Cache Revalidation Secrets (REQUIRED in production)
CRON_SECRET="replace-with-cron-secret"
REVALIDATION_SECRET="replace-with-revalidation-secret"
