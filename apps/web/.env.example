# Bitgard Web Environment Variables Example
DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_URL="http://localhost:3001"
AUTH_SECRET="generate-a-secure-secret-here"

# Dodo Payments (Merchant of Record)
DODO_PAYMENTS_API_KEY="test_your_dodo_api_key_here"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" or "live_mode"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_your_webhook_secret_here"

# Vigil Dodo Payments Product IDs (from Dodo Payments Dashboard)
DODO_PRODUCT_ID_STARTER="pdt_vigil_starter"
DODO_PRODUCT_ID_PROFESSIONAL="pdt_vigil_professional"
DODO_PRODUCT_ID_ENTERPRISE="pdt_vigil_enterprise"
